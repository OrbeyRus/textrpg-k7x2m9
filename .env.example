# Скопируйте файл в .env и укажите свой ключ proxyapi.
PROXYAPI_KEY=your_key_here

# Отладка сервера: 1 — печатать в консоль поиск по книге и разбор тегов.
DEBUG=0

# Модель эмбеддингов для поиска по книге (локальный Ollama).
# Мультиязычные варианты лучше работают с русским текстом: bge-m3, snowflake-arctic-embed2.
# После смены модели выполните: python scripts/reindex_books.py
EMBED_MODEL=nomic-embed-text
